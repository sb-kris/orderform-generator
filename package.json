{
  "name": "surveysparrow-service-order-form-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:pdf": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/verify-pdf.mts",
    "verify:docx": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/verify-docx.mts",
    "verify:qa": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/verify-qa.mts",
    "export:pdf:html-poc": "TSX_TSCONFIG_PATH=tsconfig.app.json tsx scripts/export-html-poc.mts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/great-vibes": "^5.2.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-radio-group": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^0.454.0",
    "motion": "^11.11.17",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
